{
  "manifest_version": 3,
  "name": "奶娃过四级",
  "version": "1.6.0",
  "description": "奶娃陪你过四级：收集视频字幕中的词汇（四级/六级/雅思/自定义词表，优先读取沉浸式翻译的双语字幕），每个 3 分钟区间记录一个精确出现时间点（可点击跳回），卡片式四选一记词",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "youtube-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "cet4_words.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "奶娃过四级"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
