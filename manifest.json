{
  "manifest_version": 3,
  "name": "奶娃过四级",
  "version": "1.3.0",
  "description": "从视频字幕收集四级、六级和雅思词汇，支持普通学习与中文四选一测试，记录时间点并标记熟悉词",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://youtube.com/*", "https://*.youtube.com/*"],
      "js": ["youtube-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["cet4_words.json", "cet6_words.json", "ielts_words.json"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "奶娃过四级"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
